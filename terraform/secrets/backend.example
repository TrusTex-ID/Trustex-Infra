# Plantilla de terraform/secrets/backend
# Copia este fichero a "backend" (sin extension), rellena los valores
# y ejecuta: make secrets-encrypt
#
# El fichero "backend" NUNCA se sube a git. Solo se sube "backend.age".
# Todo lo que pongas aqui se inyecta tal cual como variable de entorno del
# Cloud Run del backend (trustex-web/backend). El contrato exacto esta en
# backend/src/config/env.ts: si falta una obligatoria, el revision no arranca.
#
# Las variables de la base de datos NO van aqui: viven en "postgres" y Terraform
# las usa solo para crear Cloud SQL y construir DATABASE_URL.
#
# NO hace falta poner aqui estas variables, Terraform las inyecta sola:
#
#   DATABASE_URL               -> socket de Cloud SQL con usuario/clave de "postgres"
#   INSTANCE_CONNECTION_NAME   -> project:region:instance
#   DSS_VALIDATION_URL         -> URL del Cloud Run de DSS
#
# Cloud Run inyecta PORT automaticamente; no lo declares.

# --- App -------------------------------------------------------------------
NODE_ENV=production

# Origen del navegador para CORS. Normalmente no hace falta: la SPA llama a
# /api/v1 en su mismo origen a traves del proxy de nginx. Si lo necesitas, es
# mas comodo usar la variable frontend_public_url en terraform.tfvars.
# FRONTEND_URL=https://app.trustex.eu

# --- Auth ------------------------------------------------------------------
# Obligatorias. JWT_SECRET: cadena larga y aleatoria.
JWT_SECRET=CHANGE_ME

# Token de un solo uso para crear el primer admin (minimo 16 caracteres).
# Dejalo vacio o borra la linea cuando ya exista un admin.
BOOTSTRAP_TOKEN=

# --- Blockchain ------------------------------------------------------------
# Obligatorias todas menos TOKEN_IMPLEMENTATION_ADDRESS.
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=CHANGE_ME
FACTORY_CONTRACT_ADDRESS=CHANGE_ME
FORWARDER_CONTRACT_ADDRESS=CHANGE_ME
TOKEN_IMPLEMENTATION_ADDRESS=

# Cifrado de las wallets de operador. Obligatoria, exactamente 64 hex (32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=CHANGE_ME

# --- Pinata / IPFS ---------------------------------------------------------
# PINATA_JWT es obligatoria.
PINATA_JWT=CHANGE_ME
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# --- Digital Product Passport ----------------------------------------------
DEFAULT_DPP_SCHEMA_VERSION=en18223-2026-v1

# --- Scantrust -------------------------------------------------------------
SCANTRUST_UAT_TOKEN=
SCANTRUST_BASE_URL=https://api.staging.scantrust.io/api/v2/

# --- Geolocalizacion por IP (idioma inicial del frontend) ------------------
# Cabecera de pais que inyecta el proxy/CDN. Sin Cloudflare delante, Google
# Cloud Load Balancing envia X-Client-Geo-Location y Cloud Run no envia ninguna,
# asi que en *.run.app se cae al GEOIP_API_URL.
GEO_COUNTRY_HEADER=cf-ipcountry

# API externa de geolocalizacion, con {ip} como placeholder. Vacio = desactivada.
GEOIP_API_URL=https://ipapi.co/{ip}/json/
