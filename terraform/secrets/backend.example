# Plantilla de terraform/secrets/backend
# Copia este fichero a "backend" (sin extension), rellena los valores
# y ejecuta: make secrets-encrypt
#
# El fichero "backend" NUNCA se sube a git. Solo se sube "backend.age".
# Las variables de DB van en "postgres"; este fichero es para el Node backend.
# Si una clave coincide en ambos, gana la de "backend".
#
# NO hace falta poner aqui estas variables, Terraform las inyecta sola:
#
#   INSTANCE_CONNECTION_NAME   -> de la instancia de Cloud SQL
#   DB_HOST                    -> /cloudsql/project:region:instance
#   JAVA_SERVICE_URL           -> URL del Cloud Run de Java

NODE_ENV=production
PORT=8080

JWT_SECRET=CHANGE_ME
API_KEY=CHANGE_ME
