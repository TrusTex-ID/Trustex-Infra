# Plantilla de terraform/secrets/postgres
# Copia este fichero a "postgres" (sin extension), rellena los valores
# y ejecuta: make secrets-encrypt
#
# El fichero "postgres" NUNCA se sube a git. Solo se sube "postgres.age".
#
# Estas tres variables son entradas para Terraform, no variables de entorno de
# ningun servicio: con ellas crea la base de datos y el usuario de Cloud SQL, y
# construye la DATABASE_URL que reciben el backend y el job de migraciones:
#
#   postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
#     ?host=/cloudsql/<connection name>&schema=public
#
# Cambiar DB_PASSWORD aqui y aplicar rota la clave en Cloud SQL y en los
# servicios a la vez. DB_NAME y DB_USER no se pueden cambiar sin recrear la
# base de datos y el usuario.

DB_NAME=trustex
DB_USER=trustex
DB_PASSWORD=CHANGE_ME
