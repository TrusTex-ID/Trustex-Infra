# Plantilla de terraform/secrets/postgres
# Copia este fichero a "postgres" (sin extension), rellena los valores
# y ejecuta: make secrets-encrypt
#
# El fichero "postgres" NUNCA se sube a git. Solo se sube "postgres.age".
# Se inyecta en el backend Node y en el servicio Java.
#
# NO hace falta poner aqui estas variables, Terraform las calcula e inyecta
# automaticamente a partir de la instancia de Cloud SQL:
#
#   INSTANCE_CONNECTION_NAME   -> project:region:instance
#   DB_HOST                    -> /cloudsql/project:region:instance
#   SPRING_DATASOURCE_URL      -> JDBC con el socket factory de Cloud SQL
#
# Si defines INSTANCE_CONNECTION_NAME o DB_HOST, se ignoran: gana Terraform.
# SPRING_DATASOURCE_URL si se puede sobrescribir aqui (para parametros JDBC extra).

DB_NAME=trustex
DB_USER=trustex
DB_PASSWORD=CHANGE_ME

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_USERNAME=trustex
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
