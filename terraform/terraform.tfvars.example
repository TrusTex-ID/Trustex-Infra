project_id  = "your-gcp-project-id"
region      = "europe-southwest1"
environment = "dev"

# After first apply, push images and set these (or re-apply with new values):
# frontend_image = "europe-southwest1-docker.pkg.dev/your-gcp-project-id/trustex/frontend:latest"
# backend_image  = "europe-southwest1-docker.pkg.dev/your-gcp-project-id/trustex/backend:latest"
# java_image     = "europe-southwest1-docker.pkg.dev/your-gcp-project-id/trustex/java:latest"

# Budget defaults (keep these for ~$20–25/month target):
# db_tier                  = "db-f1-micro"
# cloud_run_min_instances  = 0
# enable_load_balancer     = false

# Optional custom domain (free managed SSL via Cloud Run domain mapping):
# frontend_custom_domain = "app.example.com"

# Only enable if you accept ~+$18/month for a Global HTTPS LB:
# enable_load_balancer = true
# lb_domains           = ["app.example.com"]
