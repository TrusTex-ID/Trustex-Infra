# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file can be committed; ignore local plan files
*.tfplan
*.plan

# ---------------------------------------------------------------------------
# Secrets: plaintext + private age key stay local.
# Encrypted *.age, public key, examples and README are committed.
# ---------------------------------------------------------------------------
terraform/secrets/.age.key
terraform/secrets/*
!terraform/secrets/.gitkeep
!terraform/secrets/.age.pubkey
!terraform/secrets/*.age
!terraform/secrets/*.example
!terraform/secrets/README.md

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
